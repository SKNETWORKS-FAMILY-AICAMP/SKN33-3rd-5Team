# Local Streamlit + Chroma. PersistentClient를 쓰는 로컬 Chroma에는 API 키가 필요 없다.
CHROMA_PATH=data/chroma
CHROMA_COLLECTION_NAME=rpi_official
DOCUMENT_MANIFEST=data/documents/manifest.json
PRODUCT_CATALOG=data/products/catalog.json
E5_MODEL_NAME=intfloat/multilingual-e5-base
# Normalized E5 vector의 Chroma L2 distance가 이 값 이하일 때만 Dense 근거로 사용한다.
DENSE_MAX_DISTANCE=0.48

# RunPod inference endpoint. Leave blank to use the deterministic local fallback.
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=
CONDITION_EXTRACTOR=baseline
LORA_ADAPTER_PATH=
TOP_K=5
