# Local Streamlit + Chroma. PersistentClient를 쓰는 로컬 Chroma에는 API 키가 필요 없다.
CHROMA_PATH=data/indexed/chroma_official_v3
CHROMA_COLLECTION_NAME=rpi_official
# `source_registry_v3.csv`에서 생성한 제품 추천용 공식 corpus manifest.
DOCUMENT_MANIFEST=document_pipeline/data/manifest_v3.json
# document manifest와 같은 원문·버전에서 생성한 citation-linked guide media metadata.
MEDIA_MANIFEST=document_pipeline/data/media_manifest_v3.json
# 팀 검수 사실 데이터로 Git에 포함한다. 운영에서는 필요하면 volume 경로로 덮어쓴다.
PRODUCT_CATALOG=data/products/catalog.json
E5_MODEL_NAME=intfloat/multilingual-e5-base
# Normalized E5 vector의 Chroma L2 distance가 이 값 이하일 때만 Dense 근거로 사용한다.
DENSE_MAX_DISTANCE=0.48

# auto는 CUDA → Apple Silicon MPS → CPU 순으로 선택한다. 명시값은 cuda, mps, cpu다.
# 4-bit BitsAndBytes 양자화는 CUDA에서만 유효하며 MPS·CPU에서는 자동으로 해제된다.
INFERENCE_DEVICE=auto

# QA 답변 생성기. template은 모델 없이, huggingface는 INFERENCE_DEVICE의 PyTorch 장치에서 실행한다.
ANSWER_GENERATOR=template
#ANSWER_GENERATOR=huggingface

ANSWER_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
ANSWER_MODEL_REVISION=main
ANSWER_LOAD_IN_4BIT=true
ANSWER_MAX_NEW_TOKENS=512

# 제품 추천 조건 추출기. baseline도 실제 Qwen Base를 로드하며 mock이 아니다.
# CUDA RunPod 추천 실행은 lora와 학습 완료 Adapter 경로를 사용한다. MPS·CPU는 full-precision으로 로드한다.
CONDITION_EXTRACTOR=lora
CONDITION_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
LORA_ADAPTER_PATH=/workspace/models/picare-qwen3-4b-qlora
CONDITION_LOAD_IN_4BIT=true
# RunPod API Key·endpoint URL은 Pod 생성/관리용이며 QA 런타임 .env에 저장하지 않는다.
TOP_K=5
